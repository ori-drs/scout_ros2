<?xml version='1.0' encoding='utf-8'?>
<robot name="scout_v2">
  <link name="base_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="package://scout_description/meshes/base_link.dae" />
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.008" />
      <geometry>
        <box size="0.925 0.38 0.21" />
      </geometry>
    </collision>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.034999999999999996" />
      <geometry>
        <box size="0.15416666666666667 0.627 0.06999999999999999" />
      </geometry>
    </collision>
  </link>
  <link name="base_footprint" />
  <joint name="base_footprint_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 -0.23479" />
    <parent link="base_link" />
    <child link="base_footprint" />
  </joint>
  <link name="inertial_link">
    <inertial>
      <mass value="40" />
      <origin xyz="0.0 0.0 0.0" />
      <inertia ixx="2.288641" ixy="0" ixz="0" iyy="5.103976" iyz="0" izz="3.431465" />
    </inertial>
  </link>
  <joint name="inertial_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0" />
    <parent link="base_link" />
    <child link="inertial_link" />
  </joint>
  <link name="front_right_wheel_link">
    <inertial>
      <mass value="3" />
      <origin xyz="0 0 0" />
      <inertia ixx="0.7171" ixy="0" ixz="0" iyy="0.1361" iyz="0" izz="0.7171" />
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="package://scout_description/meshes/wheel_type1.dae" />
      </geometry>
    </visual>
    <collision>
      <origin rpy="1.570795 0 0" xyz="0 0 0" />
      <geometry>
        <cylinder length="0.11653" radius="0.16459" />
      </geometry>
    </collision>
  </link>
  <joint name="front_right_wheel" type="continuous">
    <parent link="base_link" />
    <child link="front_right_wheel_link" />
    <origin rpy="3.14 0 0" xyz="0.249 -0.29153 -0.0702" />
    <axis rpy="0 0 0" xyz="0 -1 0" />
    <dynamics damping="0.1" friction="0.0" />
  </joint>
  <link name="front_left_wheel_link">
    <inertial>
      <mass value="3" />
      <origin xyz="0 0 0" />
      <inertia ixx="0.7171" ixy="0" ixz="0" iyy="0.1361" iyz="0" izz="0.7171" />
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="package://scout_description/meshes/wheel_type2.dae" />
      </geometry>
    </visual>
    <collision>
      <origin rpy="1.570795 0 0" xyz="0 0 0" />
      <geometry>
        <cylinder length="0.11653" radius="0.16459" />
      </geometry>
    </collision>
  </link>
  <joint name="front_left_wheel" type="continuous">
    <parent link="base_link" />
    <child link="front_left_wheel_link" />
    <origin rpy="0 0 0" xyz="0.249 0.29153 -0.0702" />
    <axis rpy="0 0 0" xyz="0 1 0" />
    <dynamics damping="0.1" friction="0.0" />
  </joint>
  <link name="rear_left_wheel_link">
    <inertial>
      <mass value="3" />
      <origin xyz="0 0 0" />
      <inertia ixx="0.7171" ixy="0" ixz="0" iyy="0.1361" iyz="0" izz="0.7171" />
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="package://scout_description/meshes/wheel_type1.dae" />
      </geometry>
    </visual>
    <collision>
      <origin rpy="1.570795 0 0" xyz="0 0 0" />
      <geometry>
        <cylinder length="0.11653" radius="0.16459" />
      </geometry>
    </collision>
  </link>
  <joint name="rear_left_wheel" type="continuous">
    <parent link="base_link" />
    <child link="rear_left_wheel_link" />
    <origin rpy="0 0 0" xyz="-0.249 0.29153 -0.0702" />
    <axis rpy="0 0 0" xyz="0 1 0" />
    <dynamics damping="0.1" friction="0.0" />
  </joint>
  <link name="rear_right_wheel_link">
    <inertial>
      <mass value="3" />
      <origin xyz="0 0 0" />
      <inertia ixx="0.7171" ixy="0" ixz="0" iyy="0.1361" iyz="0" izz="0.7171" />
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="package://scout_description/meshes/wheel_type2.dae" />
      </geometry>
    </visual>
    <collision>
      <origin rpy="1.570795 0 0" xyz="0 0 0" />
      <geometry>
        <cylinder length="0.11653" radius="0.16459" />
      </geometry>
    </collision>
  </link>
  <joint name="rear_right_wheel" type="continuous">
    <parent link="base_link" />
    <child link="rear_right_wheel_link" />
    <origin rpy="3.14 0 0" xyz="-0.249 -0.29153 -0.0702" />
    <axis rpy="0 0 0" xyz="0 -1 0" />
    <dynamics damping="0.1" friction="0.0" />
  </joint>
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>front_left_wheel</left_joint>
      <left_joint>rear_left_wheel</left_joint>
      <right_joint>front_right_wheel</right_joint>
      <right_joint>rear_right_wheel</right_joint>
      <wheel_separation>0.58306</wheel_separation>
      <wheel_radius>0.16459</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/model/scout_v2/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
  </gazebo>
  <gazebo reference="front_left_wheel_link">
    <mu1>0.9</mu1>
    <mu2>0.7</mu2>
  </gazebo>
  <gazebo reference="front_right_wheel_link">
    <mu1>0.9</mu1>
    <mu2>0.7</mu2>
  </gazebo>
  <gazebo reference="rear_left_wheel_link">
    <mu1>0.9</mu1>
    <mu2>0.7</mu2>
  </gazebo>
  <gazebo reference="rear_right_wheel_link">
    <mu1>0.9</mu1>
    <mu2>0.7</mu2>
  </gazebo>
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/scout_joint_states</topic>
      <joint_name>front_left_wheel</joint_name>
      <joint_name>front_right_wheel</joint_name>
      <joint_name>rear_left_wheel</joint_name>
      <joint_name>rear_right_wheel</joint_name>
    </plugin>
  </gazebo>
  <link name="hesai_xt32_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.8" />
      <inertia ixx="0.0009" ixy="0" ixz="0" iyy="0.0009" iyz="0" izz="0.0011" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.0515" length="0.076" />
      </geometry>
      <material name="hesai_black">
        <color rgba="0.12 0.12 0.14 1" />
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.0515" length="0.076" />
      </geometry>
    </collision>
  </link>
  <joint name="hesai_xt32_joint" type="fixed">
    <parent link="base_link" />
    <child link="hesai_xt32_link" />
    <origin xyz="0 0 0.25" rpy="0 0 0" />
  </joint>
  <gazebo reference="hesai_xt32_link">
    <sensor name="hesai_xt32" type="gpu_lidar">
      <topic>/hesai/points</topic>
      <gz_frame_id>hesai_xt32_link</gz_frame_id>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <ray>
        <scan>
          <horizontal>
            <samples>2000</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265359</min_angle>
            <max_angle>3.14159265359</max_angle>
          </horizontal>
          <vertical>
            <samples>32</samples>
            <resolution>1</resolution>
            <min_angle>-0.2792526803</min_angle>
            <max_angle>0.2617993878</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.05</min>
          <max>120.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
    </sensor>
  </gazebo>
</robot>
